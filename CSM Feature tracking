import { useState, useEffect, useRef } from "react";
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, LineChart, Line, Cell, PieChart, Pie, Legend } from "recharts";

const SK = { USERS:"frp_users_v3", REQS:"frp_reqs_v3", MEETS:"frp_meets_v3", SESS:"frp_sess_v3" };
const PRIORITIES = ["Critical","High","Medium","Low"];
const PC = { Critical:"#ef4444", High:"#f97316", Medium:"#eab308", Low:"#22c55e" };
const CC = ["#6366f1","#8b5cf6","#ec4899","#14b8a6","#f97316","#eab308","#06b6d4"];
const INIT_ADMINS = [
  {id:"adm1",username:"you",password:"Admin@123",name:"You (Team Lead)",role:"admin",status:"approved",createdAt:new Date().toISOString()},
  {id:"adm2",username:"manager",password:"Manager@123",name:"Manager",role:"admin",status:"approved",createdAt:new Date().toISOString()},
  {id:"adm3",username:"hop",password:"HOP@123",name:"Head of Product",role:"admin",status:"approved",createdAt:new Date().toISOString()}
];

const cardStyle = {background:"#1e293b",borderRadius:12,padding:24,border:"1px solid #334155"};
const inputStyle = {background:"#0f172a",border:"1px solid #334155",borderRadius:8,padding:"10px 14px",color:"#e2e8f0",fontSize:14,width:"100%",boxSizing:"border-box"};
const labelStyle = {fontSize:12,fontWeight:600,color:"#94a3b8",marginBottom:5,display:"block",textTransform:"uppercase",letterSpacing:"0.05em"};
const btn = (v="primary",s="md")=>({background:v==="primary"?"#6366f1":v==="danger"?"#dc2626":v==="success"?"#16a34a":"#334155",color:"white",border:"none",borderRadius:8,padding:s==="sm"?"5px 12px":"10px 20px",cursor:"pointer",fontSize:s==="sm"?12:14,fontWeight:600});
const badge = p=>({display:"inline-block",background:PC[p]+"22",color:PC[p],border:`1px solid ${PC[p]}44`,borderRadius:20,padding:"2px 10px",fontSize:12,fontWeight:600});

const callClaude = async (prompt, system="") => {
  const r = await fetch("https://api.anthropic.com/v1/messages",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({model:"claude-sonnet-4-20250514",max_tokens:1000,system,messages:[{role:"user",content:prompt}]})});
  const d = await r.json();
  return d.content?.map(b=>b.text||"").join("")||"";
};

export default function App() {
  const [user,setUser]=useState(null);
  const [page,setPage]=useState("login");
  const [tab,setTab]=useState("submit");
  const [users,setUsers]=useState([]);
  const [reqs,setReqs]=useState([]);
  const [meets,setMeets]=useState([]);
  const [ready,setReady]=useState(false);
  const [toast,setToast]=useState(null);

  useEffect(()=>{ boot(); },[]);

  const boot=async()=>{
    let u=[];
    try{const r=await window.storage.get(SK.USERS,true);u=r?JSON.parse(r.value):[];}catch{u=[];}
    if(!u.length){u=INIT_ADMINS;await window.storage.set(SK.USERS,JSON.stringify(u),true);}
    setUsers(u);
    let rq=[];
    try{const r=await window.storage.get(SK.REQS,true);rq=r?JSON.parse(r.value):[];}catch{rq=[];}
    setReqs(rq);
    let m=[];
    try{const r=await window.storage.get(SK.MEETS,true);m=r?JSON.parse(r.value):[];}catch{m=[];}
    setMeets(m);
    try{const s=await window.storage.get(SK.SESS);if(s){const sess=JSON.parse(s.value);const found=u.find(x=>x.id===sess.id);if(found?.status==="approved"){setUser(found);setPage("app");}}}catch{}
    setReady(true);
  };

  const notify=(msg,type="success")=>{setToast({msg,type});setTimeout(()=>setToast(null),3500);};

  const save={
    users:async v=>{setUsers(v);await window.storage.set(SK.USERS,JSON.stringify(v),true);},
    reqs:async v=>{setReqs(v);await window.storage.set(SK.REQS,JSON.stringify(v),true);},
    meets:async v=>{setMeets(v);await window.storage.set(SK.MEETS,JSON.stringify(v),true);},
  };

  const login=async(un,pw)=>{
    const found=users.find(u=>u.username===un&&u.password===pw);
    if(!found)return"Invalid username or password";
    if(found.status==="pending")return"Account pending admin approval. Please wait.";
    if(found.status==="rejected")return"Account rejected. Contact admin.";
    setUser(found);setPage("app");
    await window.storage.set(SK.SESS,JSON.stringify({id:found.id}));
    return null;
  };

  const logout=async()=>{setUser(null);setPage("login");try{await window.storage.delete(SK.SESS);}catch{}};

  const register=async data=>{
    if(users.find(u=>u.username===data.username))return"Username already taken";
    const nu={id:`u_${Date.now()}`,...data,role:"csm",status:"pending",createdAt:new Date().toISOString()};
    await save.users([...users,nu]);return null;
  };

  if(!ready)return<div style={{display:"flex",alignItems:"center",justifyContent:"center",minHeight:"100vh",background:"#0f172a",color:"#64748b",fontFamily:"Inter,sans-serif"}}>Loading portal…</div>;

  return (
    <div style={{fontFamily:"Inter,system-ui,sans-serif",background:"#0f172a",minHeight:"100vh",color:"#e2e8f0"}}>
      {toast&&<div style={{position:"fixed",top:20,right:20,zIndex:9999,background:toast.type==="error"?"#7f1d1d":"#14532d",border:`1px solid ${toast.type==="error"?"#dc2626":"#16a34a"}`,color:"white",padding:"12px 20px",borderRadius:10,fontSize:14,fontWeight:500,maxWidth:320}}>{toast.msg}</div>}
      {page==="login"&&<LoginPage onLogin={login} onRegister={()=>setPage("register")}/>}
      {page==="register"&&<RegisterPage onRegister={register} onBack={()=>setPage("login")}/>}
      {page==="app"&&user&&<MainApp user={user} users={users} reqs={reqs} meets={meets} save={save} logout={logout} notify={notify} tab={tab} setTab={setTab}/>}
    </div>
  );
}

function LoginPage({onLogin,onRegister}){
  const [un,setUn]=useState("");const [pw,setPw]=useState("");const [err,setErr]=useState("");const [loading,setLoading]=useState(false);
  const submit=async()=>{if(!un||!pw)return setErr("Please enter both fields");setLoading(true);const e=await onLogin(un,pw);if(e)setErr(e);setLoading(false);};
  return(
    <div style={{display:"flex",alignItems:"center",justifyContent:"center",minHeight:"100vh",padding:20}}>
      <div style={{...cardStyle,width:"100%",maxWidth:420}}>
        <div style={{textAlign:"center",marginBottom:32}}>
          <div style={{width:56,height:56,background:"linear-gradient(135deg,#6366f1,#8b5cf6)",borderRadius:16,display:"flex",alignItems:"center",justifyContent:"center",fontSize:28,margin:"0 auto 16px"}}>🚀</div>
          <h1 style={{margin:"0 0 6px",fontSize:22,fontWeight:800,color:"#f1f5f9"}}>Feature Tracker</h1>
          <p style={{margin:0,color:"#64748b",fontSize:14}}>CSM Product Feedback Portal</p>
        </div>
        {err&&<div style={{background:"#450a0a",border:"1px solid #dc2626",borderRadius:8,padding:"10px 14px",fontSize:13,color:"#fca5a5",marginBottom:16}}>{err}</div>}
        <div style={{marginBottom:14}}><label style={labelStyle}>Username</label><input style={inputStyle} value={un} onChange={e=>setUn(e.target.value)} placeholder="Enter username" onKeyDown={e=>e.key==="Enter"&&submit()}/></div>
        <div style={{marginBottom:20}}><label style={labelStyle}>Password</label><input style={inputStyle} type="password" value={pw} onChange={e=>setPw(e.target.value)} placeholder="Enter password" onKeyDown={e=>e.key==="Enter"&&submit()}/></div>
        <button style={{...btn("primary"),width:"100%",padding:"12px",fontSize:15}} onClick={submit} disabled={loading}>{loading?"Signing in…":"Sign In"}</button>
        <p style={{textAlign:"center",marginTop:16,fontSize:13,color:"#64748b"}}>New CSM? <span style={{color:"#6366f1",cursor:"pointer",fontWeight:600}} onClick={onRegister}>Request access →</span></p>
        <div style={{marginTop:20,padding:12,background:"#0f172a",borderRadius:8,fontSize:12,color:"#475569",lineHeight:1.6}}>
          <strong style={{color:"#64748b"}}>Default admin logins:</strong><br/>
          you / Admin@123 &nbsp;·&nbsp; manager / Manager@123 &nbsp;·&nbsp; hop / HOP@123
        </div>
      </div>
    </div>
  );
}

function RegisterPage({onRegister,onBack}){
  const [form,setForm]=useState({name:"",username:"",password:"",email:""});
  const [err,setErr]=useState("");const [done,setDone]=useState(false);const [loading,setLoading]=useState(false);
  const submit=async()=>{
    if(!form.name||!form.username||!form.password)return setErr("Please fill all required fields");
    if(form.password.length<6)return setErr("Password must be at least 6 characters");
    setLoading(true);const e=await onRegister(form);if(e)setErr(e);else setDone(true);setLoading(false);
  };
  if(done)return(
    <div style={{display:"flex",alignItems:"center",justifyContent:"center",minHeight:"100vh",padding:20}}>
      <div style={{...cardStyle,width:"100%",maxWidth:420,textAlign:"center"}}>
        <div style={{fontSize:48,marginBottom:12}}>⏳</div>
        <h2 style={{color:"#f1f5f9",margin:"0 0 8px"}}>Access Requested!</h2>
        <p style={{color:"#64748b",fontSize:14,lineHeight:1.6}}>Your request is pending admin approval. You'll receive access once an admin approves your account.</p>
        <button style={{...btn("primary"),marginTop:20}} onClick={onBack}>Back to Login</button>
      </div>
    </div>
  );
  return(
    <div style={{display:"flex",alignItems:"center",justifyContent:"center",minHeight:"100vh",padding:20}}>
      <div style={{...cardStyle,width:"100%",maxWidth:420}}>
        <button style={{...btn("ghost","sm"),marginBottom:20,background:"transparent",border:"1px solid #334155",color:"#94a3b8"}} onClick={onBack}>← Back</button>
        <h2 style={{margin:"0 0 4px",fontSize:20,fontWeight:700,color:"#f1f5f9"}}>Request Access</h2>
        <p style={{margin:"0 0 24px",color:"#64748b",fontSize:14}}>Submit for admin approval to join the portal</p>
        {err&&<div style={{background:"#450a0a",border:"1px solid #dc2626",borderRadius:8,padding:"10px 14px",fontSize:13,color:"#fca5a5",marginBottom:16}}>{err}</div>}
        {[["name","Full Name","text"],["username","Username","text"],["password","Password","password"],["email","Work Email (optional)","email"]].map(([k,l,t])=>(
          <div key={k} style={{marginBottom:14}}>
            <label style={labelStyle}>{l}</label>
            <input style={inputStyle} type={t} value={form[k]} onChange={e=>setForm(p=>({...p,[k]:e.target.value}))} placeholder={`Enter ${l.toLowerCase()}`}/>
          </div>
        ))}
        <button style={{...btn("primary"),width:"100%",padding:"12px",marginTop:8}} onClick={submit} disabled={loading}>{loading?"Submitting…":"Request Access"}</button>
      </div>
    </div>
  );
}

function MainApp({user,users,reqs,meets,save,logout,notify,tab,setTab}){
  const isAdmin=user.role==="admin";
  const pending=users.filter(u=>u.status==="pending").length;
  const tabs=[
    {id:"submit",label:"Submit Request",icon:"📝"},
    {id:"dashboard",label:"Dashboard",icon:"📊"},
    {id:"insights",label:"AI Insights",icon:"🤖"},
    {id:"sync",label:"PM Sync",icon:"🗓️"},
    ...(isAdmin?[{id:"admin",label:`Admin${pending>0?` (${pending})`:""}`,icon:"⚙️"}]:[]),
  ];
  return(
    <div style={{display:"flex",flexDirection:"column",minHeight:"100vh"}}>
      <nav style={{background:"#1e293b",borderBottom:"1px solid #334155",padding:"0 24px",display:"flex",alignItems:"center",justifyContent:"space-between",height:60,position:"sticky",top:0,zIndex:100}}>
        <div style={{display:"flex",alignItems:"center",gap:10}}>
          <div style={{width:32,height:32,background:"linear-gradient(135deg,#6366f1,#8b5cf6)",borderRadius:8,display:"flex",alignItems:"center",justifyContent:"center",fontSize:16}}>🚀</div>
          <span style={{fontWeight:800,fontSize:15,color:"#f1f5f9"}}>Feature Tracker</span>
          <span style={{fontSize:11,color:"#475569",background:"#0f172a",padding:"2px 8px",borderRadius:20,border:"1px solid #334155"}}>CSM Portal</span>
        </div>
        <div style={{display:"flex",alignItems:"center",gap:12}}>
          <div style={{fontSize:13,color:"#94a3b8",display:"flex",alignItems:"center",gap:8}}>
            <div style={{width:28,height:28,background:"#312e81",borderRadius:"50%",display:"flex",alignItems:"center",justifyContent:"center",fontSize:12,fontWeight:700,color:"#a5b4fc"}}>{user.name[0]}</div>
            <span>{user.name}</span>
            <span style={{background:isAdmin?"#312e81":"#1e3a5f",color:isAdmin?"#a5b4fc":"#7dd3fc",borderRadius:20,padding:"2px 8px",fontSize:11,fontWeight:700}}>{isAdmin?"Admin":"CSM"}</span>
          </div>
          <button style={{...btn("ghost","sm"),background:"transparent",border:"1px solid #334155",color:"#94a3b8"}} onClick={logout}>Logout</button>
        </div>
      </nav>
      <div style={{background:"#1e293b",borderBottom:"1px solid #334155",display:"flex",padding:"0 24px",overflowX:"auto"}}>
        {tabs.map(t=>(
          <button key={t.id} onClick={()=>setTab(t.id)} style={{background:"none",border:"none",cursor:"pointer",padding:"14px 16px",fontSize:13,fontWeight:tab===t.id?700:500,color:tab===t.id?"#6366f1":"#64748b",borderBottom:tab===t.id?"2px solid #6366f1":"2px solid transparent",whiteSpace:"nowrap",transition:"color 0.15s"}}>
            {t.icon} {t.label}
          </button>
        ))}
      </div>
      <div style={{flex:1,padding:24,maxWidth:1280,width:"100%",margin:"0 auto",boxSizing:"border-box"}}>
        {tab==="submit"&&<SubmitTab user={user} reqs={reqs} save={save} notify={notify}/>}
        {tab==="dashboard"&&<DashboardTab user={user} reqs={reqs} save={save} notify={notify} isAdmin={isAdmin}/>}
        {tab==="insights"&&<InsightsTab reqs={reqs}/>}
        {tab==="sync"&&<SyncTab user={user} meets={meets} save={save} notify={notify} isAdmin={isAdmin}/>}
        {tab==="admin"&&isAdmin&&<AdminTab users={users} save={save} notify={notify}/>}
      </div>
    </div>
  );
}

function SubmitTab({user,reqs,save,notify}){
  const today=new Date().toISOString().split("T")[0];
  const empty={customerName:"",mrr:"",description:"",cannyLink:"",csmName:user.name,priority:"High",date:today,notes:""};
  const [form,setForm]=useState(empty);const [loading,setLoading]=useState(false);
  const set=(k,v)=>setForm(p=>({...p,[k]:v}));
  const submit=async()=>{
    if(!form.customerName||!form.description||!form.csmName)return notify("Please fill all required fields","error");
    setLoading(true);
    const nr={id:`req_${Date.now()}`,...form,mrr:parseFloat(form.mrr)||0,submittedBy:user.id,createdAt:new Date().toISOString()};
    await save.reqs([...reqs,nr]);
    notify("Feature request submitted successfully! ✓");
    setForm({...empty,csmName:user.name});
    setLoading(false);
  };
  return(
    <div>
      <div style={{marginBottom:24}}>
        <h2 style={{margin:"0 0 4px",fontSize:22,fontWeight:800,color:"#f1f5f9"}}>Submit Feature Request</h2>
        <p style={{margin:0,color:"#64748b",fontSize:14}}>Log a customer feature request or enhancement from your call</p>
      </div>
      <div style={{...cardStyle,maxWidth:800}}>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:16}}>
          {[["customerName","Customer Name *","text","e.g. Acme Corp"],["mrr","MRR ($)","number","e.g. 5000"],["csmName","CSM Name *","text","Your name"],["cannyLink","Canny Portal Link","url","https://canny.io/..."],["date","Date *","date",""]].map(([k,l,t,ph])=>(
            <div key={k}>
              <label style={labelStyle}>{l}</label>
              <input style={inputStyle} type={t} value={form[k]} onChange={e=>set(k,e.target.value)} placeholder={ph}/>
            </div>
          ))}
          <div>
            <label style={labelStyle}>Priority *</label>
            <select style={inputStyle} value={form.priority} onChange={e=>set("priority",e.target.value)}>
              {PRIORITIES.map(p=><option key={p} value={p}>{p}</option>)}
            </select>
          </div>
        </div>
        <div style={{marginTop:16}}>
          <label style={labelStyle}>Feature / Enhancement Description *</label>
          <textarea style={{...inputStyle,minHeight:100,resize:"vertical"}} value={form.description} onChange={e=>set("description",e.target.value)} placeholder="Describe the feature request in detail — what the customer needs and why…"/>
        </div>
        <div style={{marginTop:14}}>
          <label style={labelStyle}>Additional Notes / Context</label>
          <textarea style={{...inputStyle,minHeight:64,resize:"vertical"}} value={form.notes} onChange={e=>set("notes",e.target.value)} placeholder="Any extra context, workarounds mentioned, use cases…"/>
        </div>
        <div style={{marginTop:20,display:"flex",alignItems:"center",gap:12}}>
          <button style={{...btn("primary"),padding:"12px 32px",fontSize:15}} onClick={submit} disabled={loading}>{loading?"Submitting…":"🚀 Submit Request"}</button>
          <button style={{...btn("ghost","sm"),background:"transparent",border:"1px solid #334155",color:"#64748b"}} onClick={()=>setForm({...empty,csmName:user.name})}>Clear</button>
        </div>
      </div>
    </div>
  );
}

function DashboardTab({user,reqs,save,notify,isAdmin}){
  const [filters,setFilters]=useState({csm:"",priority:"",dateFrom:"",dateTo:"",search:""});
  const [importing,setImporting]=useState(false);
  const fileRef=useRef();
  const flt=k=>v=>setFilters(p=>({...p,[k]:v}));
  const csms=[...new Set(reqs.map(r=>r.csmName).filter(Boolean))];
  const filtered=reqs.filter(r=>{
    if(filters.csm&&r.csmName!==filters.csm)return false;
    if(filters.priority&&r.priority!==filters.priority)return false;
    if(filters.dateFrom&&r.date<filters.dateFrom)return false;
    if(filters.dateTo&&r.date>filters.dateTo)return false;
    if(filters.search&&!JSON.stringify(r).toLowerCase().includes(filters.search.toLowerCase()))return false;
    return true;
  }).sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));

  const handleCSV=e=>{
    const file=e.target.files[0];if(!file)return;
    setImporting(true);
    const reader=new FileReader();
    reader.onload=async ev=>{
      const lines=ev.target.result.split("\n").filter(Boolean);
      const headers=lines[0].split(",").map(h=>h.trim().replace(/"/g,"").toLowerCase().replace(/\s/g,""));
      const imported=lines.slice(1).map((line,i)=>{
        const vals=line.split(",").map(v=>v.trim().replace(/"/g,""));
        const row={};headers.forEach((h,idx)=>row[h]=vals[idx]||"");
        return{id:`imp_${Date.now()}_${i}`,customerName:row.customername||row.customer||"",mrr:parseFloat(row.mrr)||0,description:row.description||row.feature||row["feature/enhancementdescription"]||"",cannyLink:row.cannylink||row.canny||"",csmName:row.csmname||row.csm||"",priority:PRIORITIES.includes(row.priority)?row.priority:"Medium",date:row.date||new Date().toISOString().split("T")[0],notes:row.notes||"",submittedBy:"csv-import",createdAt:new Date().toISOString()};
      }).filter(r=>r.customerName||r.description);
      await save.reqs([...reqs,...imported]);
      notify(`✓ Imported ${imported.length} requests`);
      setImporting(false);e.target.value="";
    };
    reader.readAsText(file);
  };

  const exportCSV=()=>{
    const h=["Date","Customer Name","MRR","Description","Canny Link","CSM Name","Priority","Notes"];
    const rows=filtered.map(r=>[r.date,`"${r.customerName}"`,r.mrr,`"${r.description}"`,r.cannyLink,`"${r.csmName}"`,r.priority,`"${r.notes||""}"`]);
    const csv=[h.join(","),...rows.map(r=>r.join(","))].join("\n");
    const a=document.createElement("a");a.href="data:text/csv;charset=utf-8,"+encodeURIComponent(csv);a.download=`feature_requests_${new Date().toISOString().split("T")[0]}.csv`;a.click();
  };

  const del=async id=>{if(!isAdmin)return;if(!confirm("Delete this request? This cannot be undone."))return;await save.reqs(reqs.filter(r=>r.id!==id));notify("Request deleted");};

  const totalMRR=filtered.reduce((s,r)=>s+(r.mrr||0),0);

  return(
    <div>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",marginBottom:20,flexWrap:"wrap",gap:12}}>
        <div>
          <h2 style={{margin:"0 0 4px",fontSize:22,fontWeight:800,color:"#f1f5f9"}}>Dashboard</h2>
          <p style={{margin:0,color:"#64748b",fontSize:14}}>Showing {filtered.length} of {reqs.length} requests</p>
        </div>
        <div style={{display:"flex",gap:8}}>
          <input type="file" ref={fileRef} accept=".csv" style={{display:"none"}} onChange={handleCSV}/>
          <button style={{...btn("ghost","sm"),background:"transparent",border:"1px solid #334155",color:"#94a3b8"}} onClick={()=>fileRef.current.click()} disabled={importing}>{importing?"⏳ Importing…":"⬆️ Import CSV"}</button>
          <button style={{...btn("ghost","sm"),background:"transparent",border:"1px solid #334155",color:"#94a3b8"}} onClick={exportCSV}>⬇️ Export CSV</button>
        </div>
      </div>

      <div style={{...cardStyle,marginBottom:16,padding:16}}>
        <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fill,minmax(150px,1fr))",gap:12}}>
          <div><label style={labelStyle}>Search</label><input style={inputStyle} value={filters.search} onChange={e=>flt("search")(e.target.value)} placeholder="Search anything…"/></div>
          <div><label style={labelStyle}>CSM</label><select style={inputStyle} value={filters.csm} onChange={e=>flt("csm")(e.target.value)}><option value="">All CSMs</option>{csms.map(c=><option key={c} value={c}>{c}</option>)}</select></div>
          <div><label style={labelStyle}>Priority</label><select style={inputStyle} value={filters.priority} onChange={e=>flt("priority")(e.target.value)}><option value="">All</option>{PRIORITIES.map(p=><option key={p} value={p}>{p}</option>)}</select></div>
          <div><label style={labelStyle}>From Date</label><input style={inputStyle} type="date" value={filters.dateFrom} onChange={e=>flt("dateFrom")(e.target.value)}/></div>
          <div><label style={labelStyle}>To Date</label><input style={inputStyle} type="date" value={filters.dateTo} onChange={e=>flt("dateTo")(e.target.value)}/></div>
          <div style={{display:"flex",alignItems:"flex-end"}}><button style={{...btn("ghost","sm"),background:"transparent",border:"1px solid #334155",color:"#64748b",width:"100%",padding:"10px"}} onClick={()=>setFilters({csm:"",priority:"",dateFrom:"",dateTo:"",search:""})}>Clear Filters</button></div>
        </div>
      </div>

      <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fill,minmax(120px,1fr))",gap:10,marginBottom:16}}>
        {[{l:"Total",v:filtered.length,c:"#6366f1"},...PRIORITIES.map(p=>({l:p,v:filtered.filter(r=>r.priority===p).length,c:PC[p]})),{l:"MRR at Risk",v:`$${totalMRR>=1000?(totalMRR/1000).toFixed(1)+"k":totalMRR}`,c:"#14b8a6"}].map(s=>(
          <div key={s.l} style={{...cardStyle,padding:"14px 16px",textAlign:"center"}}>
            <div style={{fontSize:20,fontWeight:800,color:s.c}}>{s.v}</div>
            <div style={{fontSize:11,color:"#64748b",marginTop:4,textTransform:"uppercase",letterSpacing:"0.05em"}}>{s.l}</div>
          </div>
        ))}
      </div>

      <div style={{...cardStyle,overflow:"auto",padding:0}}>
        {filtered.length===0?(
          <div style={{textAlign:"center",padding:48,color:"#475569"}}>
            <div style={{fontSize:32,marginBottom:8}}>📭</div>
            No requests found. {reqs.length===0?"Submit your first request!":"Try adjusting filters."}
          </div>
        ):(
          <table style={{width:"100%",borderCollapse:"collapse",fontSize:13}}>
            <thead>
              <tr style={{background:"#0f172a",borderBottom:"1px solid #334155"}}>
                {["Date","Customer","MRR","Description","Priority","CSM","Canny",...(isAdmin?["Actions"]:[])].map(h=>(
                  <th key={h} style={{padding:"12px 16px",textAlign:"left",color:"#64748b",fontWeight:600,whiteSpace:"nowrap",fontSize:11,textTransform:"uppercase",letterSpacing:"0.05em"}}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {filtered.map((r,i)=>(
                <tr key={r.id} style={{borderBottom:"1px solid #1e293b",background:i%2===0?"transparent":"#1a2538"}}>
                  <td style={{padding:"12px 16px",color:"#94a3b8",whiteSpace:"nowrap"}}>{r.date}</td>
                  <td style={{padding:"12px 16px",fontWeight:600,color:"#f1f5f9",whiteSpace:"nowrap"}}>{r.customerName}</td>
                  <td style={{padding:"12px 16px",color:"#14b8a6",whiteSpace:"nowrap"}}>{r.mrr?`$${r.mrr.toLocaleString()}`:"-"}</td>
                  <td style={{padding:"12px 16px",maxWidth:300,color:"#cbd5e1"}}>
                    <div title={r.description} style={{overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap",maxWidth:300}}>{r.description}</div>
                    {r.notes&&<div style={{fontSize:11,color:"#475569",marginTop:2}}>Note: {r.notes}</div>}
                  </td>
                  <td style={{padding:"12px 16px"}}><span style={badge(r.priority)}>{r.priority}</span></td>
                  <td style={{padding:"12px 16px",color:"#94a3b8",whiteSpace:"nowrap"}}>{r.csmName}</td>
                  <td style={{padding:"12px 16px"}}>{r.cannyLink?<a href={r.cannyLink} target="_blank" rel="noopener noreferrer" style={{color:"#6366f1",fontSize:12,fontWeight:600}}>Open ↗</a>:"-"}</td>
                  {isAdmin&&<td style={{padding:"12px 16px"}}><button style={{...btn("danger","sm"),padding:"4px 10px",fontSize:11}} onClick={()=>del(r.id)}>Delete</button></td>}
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  );
}

function InsightsTab({reqs}){
  const [analysis,setAnalysis]=useState("");
  const [topThree,setTopThree]=useState("");
  const [loadA,setLoadA]=useState(false);
  const [loadT,setLoadT]=useState(false);
  const [quarter,setQuarter]=useState(()=>{const n=new Date();return`${n.getFullYear()}-Q${Math.ceil((n.getMonth()+1)/3)}`;});

  const byPriority=PRIORITIES.map(p=>({name:p,count:reqs.filter(r=>r.priority===p).length}));
  const mrrByP=PRIORITIES.map(p=>({name:p,mrr:Math.round(reqs.filter(r=>r.priority===p).reduce((s,r)=>s+(r.mrr||0),0))}));
  const csmData=[...new Set(reqs.map(r=>r.csmName).filter(Boolean))].map(c=>({name:c,count:reqs.filter(r=>r.csmName===c).length})).sort((a,b)=>b.count-a.count).slice(0,8);
  const monthly=(()=>{const m={};reqs.forEach(r=>{const k=r.date?.slice(0,7);if(k)m[k]=(m[k]||0)+1;});return Object.entries(m).sort().slice(-8).map(([month,count])=>({month:month.slice(5),count}));})();
  const customerData=[...new Set(reqs.map(r=>r.customerName).filter(Boolean))].map(c=>({name:c,count:reqs.filter(r=>r.customerName===c).length,mrr:reqs.filter(r=>r.customerName===c).reduce((s,r)=>s+(r.mrr||0),0)})).sort((a,b)=>b.mrr-a.mrr).slice(0,6);

  const runAnalysis=async()=>{
    if(!reqs.length)return;setLoadA(true);
    const summary=reqs.map(r=>`- ${r.customerName} (MRR:$${r.mrr}): ${r.description} [${r.priority}, CSM:${r.csmName}]`).join("\n");
    const r=await callClaude(`Feature requests:\n${summary}\n\nAnalyze:\n1. TOP THEMES & CLUSTERS: Group similar requests, count occurrences\n2. MRR IMPACT: Which themes represent most revenue risk\n3. CSM PATTERNS: Which CSMs drive most critical requests\n4. QUICK WINS: Low-effort high-impact opportunities\n5. STRATEGIC OBSERVATIONS\n\nBe specific, data-driven, and actionable.`,"You are a senior product strategist. Analyze customer feature requests concisely. Use numbered sections, plain text.");
    setAnalysis(r);setLoadA(false);
  };

  const runTop3=async()=>{
    if(!reqs.length)return;setLoadT(true);
    const [yr,q]=quarter.split("-Q");const qn=parseInt(q);const yr_=parseInt(yr);
    const sm=(qn-1)*3+1;const em=qn*3;
    const qr=reqs.filter(r=>{if(!r.date)return false;const d=new Date(r.date);return d.getFullYear()===yr_&&(d.getMonth()+1)>=sm&&(d.getMonth()+1)<=em;});
    const use=qr.length?qr:reqs;
    const summary=use.map(r=>`- ${r.customerName} (MRR:$${r.mrr}): ${r.description} [${r.priority}]`).join("\n");
    const r=await callClaude(`${quarter} feature requests:\n${summary}\n\nPick TOP 3 to present to PM team. For each:\n- Feature name/theme\n- Why it's top priority (MRR, frequency, strategic fit)\n- Total MRR impacted\n- Recommended talking points for PM sync\n- Suggested Canny upvote strategy\n\nMake it compelling for PM prioritization.`,"You are a CSM team lead presenting to a product manager. Be concise, persuasive, and data-driven. Use numbered format.");
    setTopThree(r);setLoadT(false);
  };

  const tStyle={background:"#0f172a",borderRadius:8,padding:16,fontSize:13,lineHeight:1.8,color:"#cbd5e1",whiteSpace:"pre-wrap",maxHeight:400,overflowY:"auto"};

  return(
    <div>
      <div style={{marginBottom:24}}>
        <h2 style={{margin:"0 0 4px",fontSize:22,fontWeight:800,color:"#f1f5f9"}}>AI Insights</h2>
        <p style={{margin:0,color:"#64748b",fontSize:14}}>Visualizations and AI-powered analysis of all feature requests</p>
      </div>

      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:16,marginBottom:16}}>
        <div style={cardStyle}>
          <h3 style={{margin:"0 0 16px",fontSize:13,fontWeight:700,color:"#94a3b8",textTransform:"uppercase",letterSpacing:"0.05em"}}>Requests by Priority</h3>
          <ResponsiveContainer width="100%" height={200}>
            <BarChart data={byPriority}><CartesianGrid strokeDasharray="3 3" stroke="#334155"/><XAxis dataKey="name" stroke="#64748b" fontSize={11}/><YAxis stroke="#64748b" fontSize={11}/><Tooltip contentStyle={{background:"#1e293b",border:"1px solid #334155",borderRadius:8,fontSize:12}}/><Bar dataKey="count" radius={[4,4,0,0]}>{byPriority.map((e,i)=><Cell key={i} fill={PC[e.name]}/>)}</Bar></BarChart>
          </ResponsiveContainer>
        </div>
        <div style={cardStyle}>
          <h3 style={{margin:"0 0 16px",fontSize:13,fontWeight:700,color:"#94a3b8",textTransform:"uppercase",letterSpacing:"0.05em"}}>MRR at Risk by Priority</h3>
          <ResponsiveContainer width="100%" height={200}>
            <BarChart data={mrrByP}><CartesianGrid strokeDasharray="3 3" stroke="#334155"/><XAxis dataKey="name" stroke="#64748b" fontSize={11}/><YAxis stroke="#64748b" fontSize={11}/><Tooltip contentStyle={{background:"#1e293b",border:"1px solid #334155",borderRadius:8,fontSize:12}} formatter={v=>[`$${v.toLocaleString()}`,"MRR"]}/><Bar dataKey="mrr" radius={[4,4,0,0]}>{mrrByP.map((e,i)=><Cell key={i} fill={CC[i]}/>)}</Bar></BarChart>
          </ResponsiveContainer>
        </div>
        <div style={cardStyle}>
          <h3 style={{margin:"0 0 16px",fontSize:13,fontWeight:700,color:"#94a3b8",textTransform:"uppercase",letterSpacing:"0.05em"}}>Requests by CSM</h3>
          <ResponsiveContainer width="100%" height={200}>
            <BarChart data={csmData} layout="vertical"><CartesianGrid strokeDasharray="3 3" stroke="#334155"/><XAxis type="number" stroke="#64748b" fontSize={11}/><YAxis type="category" dataKey="name" stroke="#64748b" fontSize={11} width={90}/><Tooltip contentStyle={{background:"#1e293b",border:"1px solid #334155",borderRadius:8,fontSize:12}}/><Bar dataKey="count" fill="#8b5cf6" radius={[0,4,4,0]}/></BarChart>
          </ResponsiveContainer>
        </div>
        <div style={cardStyle}>
          <h3 style={{margin:"0 0 16px",fontSize:13,fontWeight:700,color:"#94a3b8",textTransform:"uppercase",letterSpacing:"0.05em"}}>Monthly Submission Trend</h3>
          <ResponsiveContainer width="100%" height={200}>
            <LineChart data={monthly}><CartesianGrid strokeDasharray="3 3" stroke="#334155"/><XAxis dataKey="month" stroke="#64748b" fontSize={11}/><YAxis stroke="#64748b" fontSize={11}/><Tooltip contentStyle={{background:"#1e293b",border:"1px solid #334155",borderRadius:8,fontSize:12}}/><Line type="monotone" dataKey="count" stroke="#6366f1" strokeWidth={2} dot={{fill:"#6366f1",r:4}}/></LineChart>
          </ResponsiveContainer>
        </div>
      </div>

      {customerData.length>0&&(
        <div style={{...cardStyle,marginBottom:16}}>
          <h3 style={{margin:"0 0 16px",fontSize:13,fontWeight:700,color:"#94a3b8",textTransform:"uppercase",letterSpacing:"0.05em"}}>Top Customers by MRR & Request Volume</h3>
          <ResponsiveContainer width="100%" height={180}>
            <BarChart data={customerData}><CartesianGrid strokeDasharray="3 3" stroke="#334155"/><XAxis dataKey="name" stroke="#64748b" fontSize={11}/><YAxis yAxisId="left" stroke="#64748b" fontSize={11}/><YAxis yAxisId="right" orientation="right" stroke="#64748b" fontSize={11}/><Tooltip contentStyle={{background:"#1e293b",border:"1px solid #334155",borderRadius:8,fontSize:12}}/><Legend/><Bar yAxisId="left" dataKey="mrr" fill="#6366f1" name="MRR ($)" radius={[4,4,0,0]}/><Bar yAxisId="right" dataKey="count" fill="#14b8a6" name="Requests" radius={[4,4,0,0]}/></BarChart>
          </ResponsiveContainer>
        </div>
      )}

      <div style={{...cardStyle,marginBottom:16}}>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16,flexWrap:"wrap",gap:12}}>
          <div>
            <h3 style={{margin:"0 0 4px",fontSize:16,fontWeight:700,color:"#f1f5f9"}}>🤖 AI Theme Analysis & Clustering</h3>
            <p style={{margin:0,fontSize:13,color:"#64748b"}}>Identify patterns, themes, and MRR impact across all requests</p>
          </div>
          <button style={btn("primary","sm")} onClick={runAnalysis} disabled={loadA||!reqs.length}>{loadA?"⏳ Analyzing…":"🔍 Run Analysis"}</button>
        </div>
        {analysis?<div style={tStyle}>{analysis}</div>:<div style={{textAlign:"center",padding:32,color:"#475569",fontSize:13}}>Click Run Analysis to cluster and analyze your feature requests with AI</div>}
      </div>

      <div style={cardStyle}>
        <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16,flexWrap:"wrap",gap:12}}>
          <div>
            <h3 style={{margin:"0 0 4px",fontSize:16,fontWeight:700,color:"#f1f5f9"}}>🏆 Top 3 for PM Presentation</h3>
            <p style={{margin:0,fontSize:13,color:"#64748b"}}>AI-ranked priorities for your quarterly PM sync</p>
          </div>
          <div style={{display:"flex",gap:8,alignItems:"center"}}>
            <input style={{...inputStyle,width:120}} value={quarter} onChange={e=>setQuarter(e.target.value)} placeholder="2025-Q2"/>
            <button style={btn("primary","sm")} onClick={runTop3} disabled={loadT||!reqs.length}>{loadT?"⏳ Generating…":"🎯 Generate Top 3"}</button>
          </div>
        </div>
        {topThree?<div style={tStyle}>{topThree}</div>:<div style={{textAlign:"center",padding:32,color:"#475569",fontSize:13}}>Enter a quarter (e.g. 2025-Q2) and generate your AI-ranked top 3</div>}
      </div>
    </div>
  );
}

function SyncTab({user,meets,save,notify,isAdmin}){
  const [transcript,setTranscript]=useState("");
  const [meetDate,setMeetDate]=useState(new Date().toISOString().split("T")[0]);
  const [loading,setLoading]=useState(false);
  const [sel,setSel]=useState(null);
  const [activeView,setActiveView]=useState("new");

  const analyze=async()=>{
    if(!transcript.trim())return notify("Please paste a transcript first","error");
    setLoading(true);
    const r=await callClaude(`PM Sync Meeting Transcript — ${meetDate}:\n\n${transcript}\n\nProvide structured notes:\n\n1. KEY DECISIONS MADE\n2. FEATURES/REQUESTS DISCUSSED (with status: approved/rejected/under review)\n3. ACTION ITEMS (owner + deadline if mentioned)\n4. THINGS TO NOTE (risks, blockers, concerns raised)\n5. FOLLOW-UP AGENDA FOR NEXT MEETING\n6. OPEN QUESTIONS UNRESOLVED\n\nBe specific. Extract names, timelines, and commitments.`,"You are a CSM team lead taking meeting notes. Be structured, concise, and action-oriented. Use numbered sections and bullet points.");
    const m={id:`meet_${Date.now()}`,date:meetDate,transcript,insights:r,createdBy:user.name,createdAt:new Date().toISOString()};
    const updated=[m,...meets];
    await save.meets(updated);
    setSel(m);setActiveView("view");
    setTranscript("");
    notify("✓ Meeting analyzed and saved!");
    setLoading(false);
  };

  const delMeet=async id=>{
    if(!isAdmin)return;if(!confirm("Delete this meeting?"))return;
    await save.meets(meets.filter(m=>m.id!==id));
    if(sel?.id===id){setSel(null);setActiveView("new");}
    notify("Meeting deleted");
  };

  return(
    <div>
      <div style={{marginBottom:24}}>
        <h2 style={{margin:"0 0 4px",fontSize:22,fontWeight:800,color:"#f1f5f9"}}>PM Sync Meetings</h2>
        <p style={{margin:0,color:"#64748b",fontSize:14}}>Paste bi-weekly PM sync transcripts and get structured AI insights and follow-ups</p>
      </div>
      <div style={{display:"grid",gridTemplateColumns:"260px 1fr",gap:16}}>
        <div>
          <div style={cardStyle}>
            <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:14}}>
              <h3 style={{margin:0,fontSize:13,fontWeight:700,color:"#94a3b8",textTransform:"uppercase",letterSpacing:"0.05em"}}>Meetings</h3>
              <button style={{...btn("primary","sm"),padding:"4px 10px",fontSize:11}} onClick={()=>{setSel(null);setActiveView("new");}}>+ New</button>
            </div>
            {meets.length===0?<p style={{fontSize:13,color:"#475569",textAlign:"center",padding:"16px 0"}}>No meetings yet</p>:
              meets.map(m=>(
                <div key={m.id} onClick={()=>{setSel(m);setActiveView("view");}} style={{padding:"10px 12px",borderRadius:8,cursor:"pointer",marginBottom:4,background:sel?.id===m.id?"#312e81":"transparent",border:sel?.id===m.id?"1px solid #6366f1":"1px solid transparent",transition:"all 0.15s"}}>
                  <div style={{fontSize:13,fontWeight:600,color:"#f1f5f9"}}>{m.date}</div>
                  <div style={{fontSize:11,color:"#64748b",marginTop:2}}>by {m.createdBy}</div>
                  {isAdmin&&<button style={{...btn("danger","sm"),padding:"2px 8px",fontSize:10,marginTop:6}} onClick={e=>{e.stopPropagation();delMeet(m.id);}}>Delete</button>}
                </div>
              ))
            }
          </div>
        </div>
        <div>
          {activeView==="view"&&sel?(
            <div style={cardStyle}>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16}}>
                <div>
                  <h3 style={{margin:"0 0 4px",fontSize:16,fontWeight:700,color:"#f1f5f9"}}>Meeting — {sel.date}</h3>
                  <div style={{fontSize:12,color:"#64748b"}}>Added by {sel.createdBy}</div>
                </div>
              </div>
              <div style={{background:"#0f172a",borderRadius:8,padding:20,fontSize:13,lineHeight:1.9,color:"#cbd5e1",whiteSpace:"pre-wrap",maxHeight:500,overflowY:"auto"}}>{sel.insights}</div>
              <details style={{marginTop:16}}>
                <summary style={{cursor:"pointer",fontSize:13,color:"#64748b",fontWeight:600,padding:"8px 0"}}>📄 View Original Transcript</summary>
                <div style={{background:"#0f172a",borderRadius:8,padding:14,fontSize:12,color:"#475569",whiteSpace:"pre-wrap",marginTop:8,maxHeight:300,overflowY:"auto"}}>{sel.transcript}</div>
              </details>
            </div>
          ):(
            <div style={cardStyle}>
              <h3 style={{margin:"0 0 20px",fontSize:16,fontWeight:700,color:"#f1f5f9"}}>Add New Meeting</h3>
              <div style={{marginBottom:16}}>
                <label style={labelStyle}>Meeting Date</label>
                <input style={{...inputStyle,maxWidth:220}} type="date" value={meetDate} onChange={e=>setMeetDate(e.target.value)}/>
              </div>
              <div>
                <label style={labelStyle}>Paste Meeting Transcript or Notes</label>
                <textarea style={{...inputStyle,minHeight:280,resize:"vertical",fontFamily:"monospace",fontSize:13,lineHeight:1.6}} value={transcript} onChange={e=>setTranscript(e.target.value)} placeholder="Paste your PM sync meeting transcript here…&#10;&#10;Include speaker names, decisions made, action items discussed, and any feature request prioritization discussions."/>
              </div>
              <button style={{...btn("primary"),marginTop:16,padding:"12px 28px",fontSize:15}} onClick={analyze} disabled={loading||!transcript.trim()}>{loading?"🤖 Analyzing transcript…":"🤖 Analyze with AI"}</button>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

function AdminTab({users,save,notify}){
  const pending=users.filter(u=>u.status==="pending");
  const approve=async id=>{await save.users(users.map(u=>u.id===id?{...u,status:"approved"}:u));notify("✓ User approved!");};
  const reject=async id=>{await save.users(users.map(u=>u.id===id?{...u,status:"rejected"}:u));notify("User rejected");};
  const changeRole=async(id,role)=>{await save.users(users.map(u=>u.id===id?{...u,role}:u));notify("Role updated");};
  const remove=async id=>{if(!confirm("Remove this user?"))return;await save.users(users.filter(u=>u.id!==id));notify("User removed");};

  return(
    <div>
      <div style={{marginBottom:24}}>
        <h2 style={{margin:"0 0 4px",fontSize:22,fontWeight:800,color:"#f1f5f9"}}>⚙️ Admin Panel</h2>
        <p style={{margin:0,color:"#64748b",fontSize:14}}>Manage user access, roles, and approvals</p>
      </div>

      {pending.length>0&&(
        <div style={{...cardStyle,marginBottom:20,border:"1px solid #92400e",background:"#1c1404"}}>
          <h3 style={{margin:"0 0 16px",color:"#fbbf24",fontSize:15,display:"flex",alignItems:"center",gap:8}}>
            <span style={{background:"#dc2626",color:"white",borderRadius:"50%",width:20,height:20,display:"inline-flex",alignItems:"center",justifyContent:"center",fontSize:11,fontWeight:700}}>{pending.length}</span>
            Pending Approvals
          </h3>
          {pending.map(u=>(
            <div key={u.id} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"14px 0",borderBottom:"1px solid #334155",flexWrap:"wrap",gap:8}}>
              <div>
                <div style={{fontWeight:700,color:"#f1f5f9",fontSize:14}}>{u.name}</div>
                <div style={{fontSize:12,color:"#64748b",marginTop:2}}>@{u.username} {u.email&&`· ${u.email}`} · Requested {new Date(u.createdAt).toLocaleDateString()}</div>
              </div>
              <div style={{display:"flex",gap:8}}>
                <button style={btn("success","sm")} onClick={()=>approve(u.id)}>✓ Approve</button>
                <button style={btn("danger","sm")} onClick={()=>reject(u.id)}>✗ Reject</button>
              </div>
            </div>
          ))}
        </div>
      )}

      <div style={cardStyle}>
        <h3 style={{margin:"0 0 16px",color:"#94a3b8",fontSize:13,textTransform:"uppercase",letterSpacing:"0.05em",fontWeight:700}}>All Users ({users.length})</h3>
        <div style={{overflowX:"auto"}}>
          <table style={{width:"100%",borderCollapse:"collapse",fontSize:13}}>
            <thead>
              <tr style={{background:"#0f172a",borderBottom:"1px solid #334155"}}>
                {["Name","Username","Role","Status","Joined","Actions"].map(h=>(
                  <th key={h} style={{padding:"10px 14px",textAlign:"left",color:"#64748b",fontWeight:600,fontSize:11,textTransform:"uppercase",letterSpacing:"0.05em",whiteSpace:"nowrap"}}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {users.sort((a,b)=>a.role==="admin"?-1:1).map(u=>(
                <tr key={u.id} style={{borderBottom:"1px solid #1a2538"}}>
                  <td style={{padding:"12px 14px",fontWeight:600,color:"#f1f5f9"}}>{u.name}</td>
                  <td style={{padding:"12px 14px",color:"#94a3b8"}}>@{u.username}</td>
                  <td style={{padding:"12px 14px"}}>
                    <select style={{...inputStyle,padding:"4px 10px",width:"auto",fontSize:12}} value={u.role} onChange={e=>changeRole(u.id,e.target.value)}>
                      <option value="csm">CSM</option>
                      <option value="admin">Admin</option>
                    </select>
                  </td>
                  <td style={{padding:"12px 14px"}}>
                    <span style={{background:u.status==="approved"?"#14532d":u.status==="pending"?"#78350f":"#450a0a",color:u.status==="approved"?"#86efac":u.status==="pending"?"#fde68a":"#fca5a5",borderRadius:20,padding:"3px 10px",fontSize:11,fontWeight:600}}>
                      {u.status}
                    </span>
                  </td>
                  <td style={{padding:"12px 14px",color:"#475569",fontSize:12,whiteSpace:"nowrap"}}>{new Date(u.createdAt).toLocaleDateString()}</td>
                  <td style={{padding:"12px 14px"}}>
                    <div style={{display:"flex",gap:6",flexWrap:"wrap",gap:4}}>
                      {u.status==="pending"&&<button style={{...btn("success","sm"),padding:"4px 10px"}} onClick={()=>approve(u.id)}>Approve</button>}
                      {u.status==="rejected"&&<button style={{...btn("success","sm"),padding:"4px 10px"}} onClick={()=>approve(u.id)}>Re-approve</button>}
                      <button style={{...btn("danger","sm"),padding:"4px 10px"}} onClick={()=>remove(u.id)}>Remove</button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}
